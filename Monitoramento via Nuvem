<!-- CONFIGURAÇÕES -->
<div class="settings" id="settings">

    <div class="settings-header">
        <div class="settings-title">Configurações</div>
        <button class="close" id="closeSettings">×</button>
    </div>

    <!-- COR DO MONITORAMENTO -->
    <div class="setting">
        <div class="setting-title">Cor do Monitoramento</div>
        <div class="color-picker-container">
            <input type="color" id="accentColorPicker" value="#00ffcc">
            <span class="color-value" id="colorCode">#00ffcc</span>
        </div>
    </div>

    <!-- TAMANHO DO RELÓGIO -->
    <div class="setting">
        <div class="setting-title">Tamanho do Relógio</div>
        <input type="range" id="clockScale" min="0.7" max="1.6" step="0.05" value="1">
    </div>

    <!-- TAMANHO DOS CARDS -->
    <div class="setting">
        <div class="setting-title">Tamanho do Monitor</div>
        <input type="range" id="cardScale" min="0.5" max="1" step="0.05" value="0.75">
    </div>

    <!-- TRANSPARÊNCIA -->
    <div class="setting">
        <div class="setting-title">Transparência</div>
        <input type="range" id="transparency" min="5" max="25" value="11">
    </div>

    <!-- PASSAGEM AUTOMÁTICA DOS WALLPAPERS -->
    <div class="setting setting-row">
        <div class="setting-title">Passagem Automática</div>
        <label class="switch">
            <input type="checkbox" id="autoWallpaperToggle" checked>
            <span class="slider"></span>
        </label>
    </div>

    <!-- TEMPO DE TROCA -->
    <div class="setting setting-row" id="wallpaperTimerContainer">
        <div class="setting-title">Tempo de Troca</div>
        <select id="wallpaperInterval" class="custom-select">
            <option value="5000">5 segundos</option>
            <option value="10000" selected>10 segundos</option>
            <option value="30000">30 segundos</option>
            <option value="60000">1 minuto</option>
            <option value="300000">5 minutos</option>
        </select>
    </div>

    <!-- WALLPAPERS -->
    <div class="setting">
        <div class="setting-title">Wallpaper</div>
        <div class="wallpapers" id="wallpapers">Carregando...</div>
    </div>

</div>

<script>

/* =========================================================
   RELÓGIO COM DATA ESTILO iOS
   ========================================================= */

function atualizarRelogio() {
    const agora = new Date();
    
    const horas = String(agora.getHours()).padStart(2, '0');
    const minutos = String(agora.getMinutes()).padStart(2, '0');
    const segundos = String(agora.getSeconds()).padStart(2, '0');
    document.getElementById("clockTime").textContent = `${horas}:${minutos}:${segundos}`;

    const opcoesData = { weekday: 'long', day: 'numeric', month: 'long' };
    const dataFormatada = agora.toLocaleDateString('pt-BR', opcoesData);
    document.getElementById("clockDate").textContent = dataFormatada;
}

setInterval(atualizarRelogio, 1000);
atualizarRelogio();


/* =========================================================
   CONTROLES DE TAMANHO (CARDS E RELÓGIO)
   ========================================================= */

const cardScaleInput = document.getElementById("cardScale");
document.documentElement.style.setProperty('--card-scale', cardScaleInput.value);

cardScaleInput.addEventListener("input", (e) => {
    document.documentElement.style.setProperty('--card-scale', e.target.value);
});

const clockScaleInput = document.getElementById("clockScale");
document.documentElement.style.setProperty('--clock-scale', clockScaleInput.value);

clockScaleInput.addEventListener("input", (e) => {
    document.documentElement.style.setProperty('--clock-scale', e.target.value);
});


/* =========================================================
   SELETOR DE COR DO MONITORAMENTO
   ========================================================= */

const colorPicker = document.getElementById("accentColorPicker");
const colorCode = document.getElementById("colorCode");

document.documentElement.style.setProperty('--accent-color', colorPicker.value);

colorPicker.addEventListener("input", (e) => {
    const novaCor = e.target.value;
    document.documentElement.style.setProperty('--accent-color', novaCor);
    colorCode.textContent = novaCor;
});


/* =========================================================
   GAUGES
   ========================================================= */

const circumference = 2 * Math.PI * 50;
const cpuProgress = document.getElementById("cpuProgress");
const gpuProgress = document.getElementById("gpuProgress");
const ramProgress = document.getElementById("ramProgress");

cpuProgress.style.strokeDasharray = circumference;
gpuProgress.style.strokeDasharray = circumference;
ramProgress.style.strokeDasharray = circumference;

function setGauge(element, value) {
    if (value === null || value === undefined) {
        element.style.strokeDashoffset = circumference;
        return;
    }

    value = Math.max(0, Math.min(100, Number(value)));
    const offset = circumference - (value / 100) * circumference;
    element.style.strokeDashoffset = offset;
}


/* =========================================================
   TEXTOS
   ========================================================= */

function updateText(id, value, suffix = "") {
    const element = document.getElementById(id);
    if (value === null || value === undefined) {
        element.textContent = "--" + suffix;
    } else {
        element.textContent = value + suffix;
    }
}


/* =========================================================
   GRÁFICOS
   ========================================================= */

const history = { cpu: [], gpu: [], ram: [] };
const maxHistory = 30;

function addHistory(type, value) {
    if (value === null || value === undefined) return;

    history[type].push(Number(value));

    if (history[type].length > maxHistory) {
        history[type].shift();
    }

    drawGraph(type);
}

function drawGraph(type) {
    const values = history[type];
    if (values.length < 2) return;

    const points = [];
    values.forEach((value, index) => {
        const x = (index / (maxHistory - 1)) * 200;
        const y = 48 - (value / 100) * 44;
        points.push(`${x.toFixed(1)},${y.toFixed(1)}`);
    });

    document.getElementById(type + "Graph").setAttribute("points", points.join(" "));
}


/* =========================================================
   WEBSOCKET
   ========================================================= */

let ws = null;
let paused = false;

function conectar() {
    const protocolo = location.protocol === "https:" ? "wss:" : "ws:";
    ws = new WebSocket(`${protocolo}//${location.host}`);

    ws.onopen = () => {
        console.log("WebSocket conectado.");
    };

    ws.onclose = () => {
        console.log("WebSocket desconectado.");
        setTimeout(conectar, 2000);
    };

    ws.onerror = () => {
        console.log("Erro na conexão WebSocket.");
    };

    ws.onmessage = (event) => {
        if (paused) return;

        try {
            const dados = JSON.parse(event.data);

            updateText("cpuValue", dados.cpu, "%");
            updateText("gpuValue", dados.gpu, "%");
            updateText("ramValue", dados.ram, "%");

            updateText("cpuTemp", dados.cpuTemp, "°C");
            updateText("gpuTemp", dados.gpuTemp, "°C");
            updateText("ramInfo", dados.ram, "%");

            setGauge(cpuProgress, dados.cpu);
            setGauge(gpuProgress, dados.gpu);
            setGauge(ramProgress, dados.ram);

            addHistory("cpu", dados.cpu);
            addHistory("gpu", dados.gpu);
            addHistory("ram", dados.ram);
        } catch (erro) {
            console.log("Erro nos dados:", erro);
        }
    };
}

conectar();


/* =========================================================
   PAUSAR
   ========================================================= */

document.getElementById("pauseBtn").addEventListener("click", () => {
    paused = !paused;
    document.getElementById("pauseBtn").textContent = paused ? "▶" : "⏸";
    document.getElementById("app").classList.toggle("paused", paused);
});


/* =========================================================
   CONFIGURAÇÕES
   ========================================================= */

const settings = document.getElementById("settings");

document.getElementById("settingsBtn").addEventListener("click", () => {
    settings.classList.add("open");
});

document.getElementById("closeSettings").addEventListener("click", () => {
    settings.classList.remove("open");
});


/* =========================================================
   TRANSPARÊNCIA (SINCRONIZADA COM CARDS E RELÓGIO)
   ========================================================= */

document.getElementById("transparency").addEventListener("input", (event) => {
    const valor = Number(event.target.value) / 100;
    document.querySelectorAll(".card, .ios-clock-widget").forEach(element => {
        element.style.background = `rgba(255,255,255,${valor})`;
    });
});


/* =========================================================
   WALLPAPERS E CONTROLE DE TEMPO DE TROCA AUTOMÁTICA
   ========================================================= */

let wallpapers = [];
let wallpaperAtual = 0;
let wallpaperTimer = null;
let autoWallpaperActive = true;
let wallpaperTempoMs = 10000; // Padrão: 10s

async function carregarWallpapers() {
    try {
        const resposta = await fetch("/api/wallpapers");
        wallpapers = await resposta.json();

        const container = document.getElementById("wallpapers");
        container.innerHTML = "";

        wallpapers.forEach((arquivo, index) => {
            const botao = document.createElement("button");
            botao.className = "wallpaper-btn";
            botao.style.backgroundImage = `url("/wallpapers/${encodeURIComponent(arquivo)}")`;
            botao.title = "Selecionar wallpaper";

            botao.addEventListener("click", () => {
                mudarWallpaper(index);
                reiniciarTimerWallpaper(); // Reinicia o tempo ao trocar manualmente
            });

            container.appendChild(botao);
        });

        if (wallpapers.length > 0) {
            mudarWallpaper(0);
            iniciarTimerWallpaper();
        }
    } catch (erro) {
        document.getElementById("wallpapers").textContent = "Não foi possível carregar.";
        console.log("Erro nos wallpapers:", erro);
    }
}

function mudarWallpaper(index) {
    if (!wallpapers.length) return;
    wallpaperAtual = index;
    const arquivo = wallpapers[index];

    document.getElementById("wallpaper").style.backgroundImage = `url("/wallpapers/${encodeURIComponent(arquivo)}")`;

    document.querySelectorAll(".wallpaper-btn").forEach((botao, i) => {
        botao.classList.toggle("active", i === index);
    });
}

function proximoWallpaper() {
    if (wallpapers.length <= 1 || paused || !autoWallpaperActive) return;
    wallpaperAtual = (wallpaperAtual + 1) % wallpapers.length;
    mudarWallpaper(wallpaperAtual);
}

function iniciarTimerWallpaper() {
    pararTimerWallpaper();
    if (autoWallpaperActive) {
        wallpaperTimer = setInterval(proximoWallpaper, wallpaperTempoMs);
    }
}

function pararTimerWallpaper() {
    if (wallpaperTimer) {
        clearInterval(wallpaperTimer);
        wallpaperTimer = null;
    }
}

function reiniciarTimerWallpaper() {
    pararTimerWallpaper();
    iniciarTimerWallpaper();
}

// Eventos dos Controles
const autoToggle = document.getElementById("autoWallpaperToggle");
const intervalSelect = document.getElementById("wallpaperInterval");

autoToggle.addEventListener("change", (e) => {
    autoWallpaperActive = e.target.checked;
    intervalSelect.disabled = !autoWallpaperActive;
    if (autoWallpaperActive) {
        iniciarTimerWallpaper();
    } else {
        pararTimerWallpaper();
    }
});

intervalSelect.addEventListener("change", (e) => {
    wallpaperTempoMs = Number(e.target.value);
    reiniciarTimerWallpaper();
});


/* =========================================================
   INICIAR
   ========================================================= */

carregarWallpapers();

</script>
</body>
</html>
