const express = require("express");
const path = require("path");
const WebSocket = require("ws");
const fs = require("fs");

const app = express();
const PORT = 3000;

// ===============================
// SITE
// ===============================

app.use(express.static(path.join(__dirname, "../site")));

// ===============================
// WALLPAPERS
// ===============================

app.use(
    "/wallpapers",
    express.static(path.join(__dirname, "../wallpapers"))
);

// Lista os wallpapers disponíveis
app.get("/api/wallpapers", (req, res) => {

    const pasta = path.join(__dirname, "../wallpapers");

    fs.readdir(pasta, (erro, arquivos) => {

        if (erro) {

            return res.status(500).json({
                erro: "Não foi possível ler os wallpapers."
            });

        }

        const imagens = arquivos.filter((arquivo) => {

            return /\.(jpg|jpeg|png|webp)$/i.test(arquivo);

        });

        res.json(imagens);
    });
});

// ===============================
// SERVIDOR
// ===============================

const server = app.listen(PORT, "0.0.0.0", () => {

    console.log(
        `Servidor rodando em http://localhost:${PORT}`
    );

});

// ===============================
// WEBSOCKET
// ===============================

const wss = new WebSocket.Server({ server });

let dadosPC = {

    cpu: 0,
    ram: 0,
    gpu: 0,
    cpuTemp: null,
    gpuTemp: null

};

wss.on("connection", (ws) => {

    console.log("Nova conexão WebSocket.");

    // Envia os dados atuais para quem acabou de conectar
    ws.send(JSON.stringify(dadosPC));

    ws.on("message", (message) => {

        try {

            const dados = JSON.parse(message);

            dadosPC = dados;

            console.log("Dados recebidos:", dados);

            // Envia os dados para os clientes conectados
            wss.clients.forEach((cliente) => {

                if (cliente.readyState === WebSocket.OPEN) {

                    cliente.send(JSON.stringify(dadosPC));

                }

            });

        } catch (erro) {

            console.log("Mensagem inválida.");

        }

    });

    ws.on("close", () => {

        console.log("Conexão encerrada.");

    });

});

// CODIGO DO MONITORAMENTO 

const si = require("systeminformation");
const WebSocket = require("ws");
const http = require("http");

const WS_URL = "ws://localhost:3000";
const LHM_URL = "http://localhost:8085/data.json";

const ws = new WebSocket(WS_URL);

ws.on("open", () => {
    console.log("Monitor conectado ao servidor.");
    monitorar();
});

ws.on("error", (erro) => {
    console.log("Erro na conexão WebSocket:", erro.message);
});

// Busca a temperatura diretamente do servidor Web do LibreHardwareMonitor
function obterTempViaLHM() {
    return new Promise((resolve) => {
        http.get(LHM_URL, (res) => {
            let body = "";
            res.on("data", (chunk) => (body += chunk));
            res.on("end", () => {
                try {
                    const json = JSON.parse(body);
                    const cpuTemp = extrairTempLHM(json);
                    resolve(cpuTemp);
                } catch (e) {
                    resolve(null);
                }
            });
        }).on("error", () => resolve(null));
    });
}

// Navega pela estrutura do seu LibreHardwareMonitor específico
function extrairTempLHM(node) {
    if (!node) return null;

    // Procura por "CPU" debaixo do grupo de Temperaturas (conforme a sua imagem)
    if (
        node.Text &&
        (node.Text === "CPU" || node.Text.includes("CPU Package") || node.Text.includes("Core Average") || node.Text === "CPU Core") &&
        node.Value &&
        node.Value.includes("°C")
    ) {
        const valorNumerico = parseFloat(node.Value.replace(",", ".").replace("°C", "").trim());
        if (!isNaN(valorNumerico) && valorNumerico > 0) {
            return valorNumerico;
        }
    }

    if (Array.isArray(node.Children)) {
        for (const child of node.Children) {
            const temp = extrairTempLHM(child);
            if (temp !== null) return temp;
        }
    }

    return null;
}

async function monitorar() {
    try {
        const cpu = await si.currentLoad();
        const memoria = await si.mem();
        const temperatura = await si.cpuTemperature();
        const gpu = await si.graphics();

        const ramUso = (memoria.used / memoria.total) * 100;

        let gpuUso = null;
        let gpuTemperatura = null;

        if (gpu.controllers && gpu.controllers.length > 0) {
            const placa = gpu.controllers.find(c => c.utilizationGpu !== undefined) || gpu.controllers[0];
            gpuUso = placa.utilizationGpu ?? null;
            gpuTemperatura = placa.temperatureGpu ?? null;
        }

        // Tenta ler do LibreHardwareMonitor aberto
        let cpuTemp = await obterTempViaLHM();

        // Fallback para biblioteca padrao
        if (cpuTemp === null && temperatura && temperatura.main > 0) {
            cpuTemp = temperatura.main;
        }

        const dados = {
            cpu: Number(cpu.currentLoad.toFixed(1)),
            ram: Number(ramUso.toFixed(1)),
            gpu: gpuUso !== null ? Number(gpuUso.toFixed(1)) : null,
            cpuTemp: cpuTemp !== null ? Number(cpuTemp.toFixed(1)) : null,
            gpuTemp: gpuTemperatura !== null ? Number(gpuTemperatura.toFixed(1)) : null
        };

        console.clear();
        console.log("===== PC MONITOR =====");
        console.log(`CPU: ${dados.cpu}%`);
        console.log(`CPU Temperatura: ${dados.cpuTemp !== null ? `${dados.cpuTemp} °C` : "N/D"}`);
        console.log(`RAM: ${dados.ram}%`);
        console.log(`GPU: ${dados.gpu !== null ? `${dados.gpu}%` : "N/D"}`);
        console.log(`GPU Temperatura: ${dados.gpuTemp !== null ? `${dados.gpuTemp} °C` : "N/D"}`);

        if (ws.readyState === WebSocket.OPEN) {
            ws.send(JSON.stringify(dados));
        }

    } catch (erro) {
        console.log("Erro ao obter informações:", erro.message);
    }
}

setInterval(monitorar, 2000);

